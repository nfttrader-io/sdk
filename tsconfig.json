{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ES5",
    "module": "ESNext",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "allowUnreachableCode": true,
    "moduleResolution": "node",
    "baseUrl": ".", // Base URL per i percorsi
    "paths": {
      "@src/*": ["src/*"] // Alias per la directory src
    },
    "allowSyntheticDefaultImports": true, // Aggiungi questa linea
    "esModuleInterop": true // Aggiungi questa linea
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/test/*", "dist"]
}
